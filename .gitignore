# ============================================================
# Sunrise Dental — .gitignore
# ============================================================

# ============================================================
# Java / Maven
# ============================================================
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
hs_err_pid*
replay_pid*

# Maven build output
backend/target/

# Maven wrapper (optional — remove if using mvnw)
# !backend/.mvn/wrapper/maven-wrapper.jar

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/

# ============================================================
# Node / Frontend
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production

# Vite cache
frontend/.vite/

# ============================================================
# OS / Editor
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json

# ============================================================
# Secrets — never commit these
# ============================================================
*.env.local
.env.production
application-local.properties
application-secret.properties
